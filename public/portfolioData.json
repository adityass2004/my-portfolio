  "research": [
    {
      "id": 1,
      "title": "Damage-Guided Adaptive Recovery for Efficient Neural Network Pruning",
      "status": "Under Review",
      "institution": "Dept. of Computing Technologies, SRMIST KTR",
      "description": "Proposed a damage-aware pruning framework that addresses irreversible performance degradation in deep learning model compression. Introduces a composite importance metric combining weight magnitude, gradient sensitivity, and activation frequency to identify redundant parameters. A per-layer damage metric pinpoints the most severely affected layers, after which selective weight restoration and targeted retraining recover representational capacity.",
      "highlights": [
        "70% parameter reduction and ~60% FLOP reduction while maintaining or surpassing baseline accuracy at up to 70% sparsity.",
        "Experiments conducted on CIFAR-10, CIFAR-100, and FashionMNIST (VGGSmall)."
      ],
      "keywords": [
        "Neural Network Pruning",
        "Model Compression",
        "Deep Learning",
        "Sparsity",
